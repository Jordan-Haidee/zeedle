import { Theme } from "theme.slint";
import { Button, LineEdit, ListView, VerticalBox } from "std-widgets.slint";
import { TriggerSource, SongInfo, SortKey } from "types.slint";

component SortIcon inherits Rectangle {
    in-out property <bool> ascending: true;
    in-out property <bool> display: true;
    height: 15px;
    width: 15px;
    background: transparent;
    if !ascending && display: Path {
        commands: "M 5 1 L 5 9 L 7 7";
        stroke: Theme.text-tertiary;
        stroke-width: 1px;
    }
    if ascending && display: Path {
        commands: "M 5 9 L 5 1 L 3 3";
        stroke: Theme.text-tertiary;
        stroke-width: 1px;
    }
}

component TitleBarItem inherits Rectangle {
    in property <string> name:"name";
    in-out property <bool> display-sort-icon <=> arrow.display;
    in-out property <bool> ascending-sort <=> arrow.ascending;
    Rectangle {
        width: 100%;
        height: 100%;
        text := Text {
            text: name;
            color: Theme.text-tertiary;
            x: parent.width * 0.4;
            y: parent.height / 2 - self.height / 2;
        }

        arrow := SortIcon {
            ascending: true;
            width: 12px;
            height: 12px;
            x: text.x + text.width + 5px;
            y: parent.height / 2 - self.height / 2;
        }
    }
}

component SortColumn inherits Rectangle {
    in property <string> label;
    in property <SortKey> sort-key;
    in property <SortKey> current-key;
    in property <bool> ascending;
    callback clicked(SortKey, bool);
    height: 100%;
    width: 33%;

    touch-area := TouchArea {
        clicked => {
            root.clicked(root.sort-key, root.ascending);
        }
        TitleBarItem {
            width: 100%;
            height: 100%;
            name: root.label;
            background: touch-area.has-hover ? Theme.hover : transparent;
            display-sort-icon: root.current-key == root.sort-key;
            ascending-sort: root.ascending;
        }
    }
}

component SortBar inherits Rectangle {
    height: 30px;
    in-out property <SortKey> key;
    in-out property <bool> ascending;
    callback sort-items(SortKey, bool);
    background: Theme.surface;

    HorizontalLayout {
        alignment: space-between;
        SortColumn {
            label: @tr("Title");
            sort-key: SortKey.BySongName;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            label: @tr("Artist");
            sort-key: SortKey.BySinger;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }

        SortColumn {
            label: @tr("Duration");
            sort-key: SortKey.ByDuration;
            current-key: root.key;
            ascending: root.ascending;
            clicked(key, asc) => {
                root.sort-items(key, asc);
            }
        }
    }
}

component SongContextMenu inherits Rectangle {
    in property <string> edit-label;
    in property <string> delete-label;
    callback edit();
    callback delete();

    width: 100%;
    height: 100%;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 6px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 4px;
        spacing: 2px;

        edit-area := TouchArea {
            width: 100%;
            height: 34px;
            clicked => { root.edit(); }
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: edit-area.has-hover ? Theme.hover : transparent;
                Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: root.edit-label;
                    color: Theme.text;
                }
            }
        }

        delete-area := TouchArea {
            width: 100%;
            height: 34px;
            clicked => { root.delete(); }
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: delete-area.has-hover ? Theme.hover : transparent;
                Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: root.delete-label;
                    color: Theme.text;
                }
            }
        }
    }
}

export component SongItem inherits Rectangle {
    height: 30px;
    in property <SongInfo> info:{ id:0, song_name:"xxx", singer:"xxx", duration:"xxx", song_path:"xxx" };
    in property <bool> playing:false;
    callback double_clicked();
    callback edit-requested(SongInfo);
    callback delete-requested(SongInfo);
    background: playing ? Theme.hover : (area.has-hover ? Theme.song-hover : Theme.surface);
    VerticalLayout {
        area := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right {
                    context-popup.show();
                }
            }
            double-clicked => {
                double_clicked();
            }
            HorizontalLayout {
                alignment: space-between;
                Rectangle {
                    width: 33%;
                    Text {
                        width: 100%;
                        x: parent.width * 0.4;
                        text: info.song-name;
                        font-weight: root.playing ? 600 : 400;
                        color: root.playing ? Theme.accent : Theme.text;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 33%;
                    Text {
                        width: 100%;
                        x: parent.width * 0.4;
                        text: info.singer;
                        color: root.playing ? Theme.accent : Theme.text;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 33%;
                    Text {
                        x: parent.width * 0.4;
                        text: info.duration;
                        color: root.playing ? Theme.accent : Theme.text;
                    }
                }
            }

            Tooltip {
                Rectangle {
                    border-color: Theme.text;
                    VerticalLayout {
                        padding: 5px;
                        Text {
                            text: @tr("Title: {}\nArtist: {}\nDuration: {}", info.song-name, info.singer, info.duration);
                        }
                    }
                }
            }
        }
    }

    context-popup-anchor := Rectangle {
        x: area.mouse-x;
        y: area.mouse-y;
        width: 1px;
        height: 1px;

        context-popup := PopupWindow {
            width: 190px;
            height: 80px;
            close-policy: close-on-click-outside;
            SongContextMenu {
                edit-label: @tr("Edit metadata");
                delete-label: @tr("Delete song");
                edit => {
                    context-popup.close();
                    root.edit-requested(root.info);
                }
                delete => {
                    context-popup.close();
                    root.delete-requested(root.info);
                }
            }
        }
    }
}

export component SongEditPopup inherits Rectangle {
    in property <SongInfo> song;
    in property <bool> saving: false;
    in property <string> error-message: "";
    in property <bool> song-missing: false;
    in-out property <bool> invalid-input: false;
    in-out property <string> edited-title: song.song-name;
    in-out property <string> edited-artist: song.singer;
    in-out property <string> album;
    in property <image> cover-preview;
    in property <bool> has-cover: false;
    in property <string> cover-name;
    in-out property <string> cover-path;
    in property <bool> has-lyrics: false;
    in property <string> lyrics-name;
    in-out property <string> lyrics-path;
    in property <string> lyrics-preview;
    callback save(string, string, string, string, string);
    callback select-cover();
    callback select-lyrics();
    callback cancel();

    width: 100%;
    height: 100%;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 16px;
        spacing: 4px;

        Text {
            text: @tr("Edit song metadata");
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
        }

        Text {
            text: @tr("Song title");
            color: Theme.text-secondary;
        }

        LineEdit {
            horizontal-stretch: 1;
            text <=> root.edited-title;
            enabled: !root.saving;
            placeholder-text: @tr("Song title");
        }

        Text {
            text: @tr("Artist");
            color: Theme.text-secondary;
        }

        LineEdit {
            horizontal-stretch: 1;
            text <=> root.edited-artist;
            enabled: !root.saving;
            placeholder-text: @tr("Artist");
        }

        Text {
            text: @tr("Album");
            color: Theme.text-secondary;
        }

        LineEdit {
            horizontal-stretch: 1;
            text <=> root.album;
            enabled: !root.saving;
            placeholder-text: @tr("Album");
        }

        HorizontalLayout {
            spacing: 10px;
            Image {
                width: 64px;
                height: 64px;
                source: root.cover-preview;
                image-fit: contain;
                visible: root.has-cover;
            }

            Rectangle {
                width: 64px;
                height: 64px;
                background: Theme.panel;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 4px;
                visible: !root.has-cover;
                Text {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    text: @tr("No embedded cover");
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Button {
                    text: @tr("Select cover image");
                    enabled: !root.saving;
                    clicked => { root.select-cover(); }
                }

                Text {
                    text: root.cover-name != "" ? root.cover-name : (root.has-cover ? @tr("Existing cover will be kept") : "");
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button {
                text: @tr("Select LRC file");
                enabled: !root.saving;
                clicked => { root.select-lyrics(); }
            }

            Text {
                text: root.lyrics-name != "" ? root.lyrics-name : (root.has-lyrics ? @tr("Existing lyrics will be kept") : @tr("No embedded lyrics"));
                color: Theme.text-secondary;
                font-size: 11px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Text {
            text: root.lyrics-preview;
            color: Theme.text-secondary;
            font-size: 11px;
            max-height: 32px;
            wrap: word-wrap;
            visible: root.lyrics-preview != "";
        }

        Text {
            text: @tr("The selected song is no longer in the library.");
            color: #D13438;
            font-size: 12px;
            visible: root.song-missing;
        }

        Text {
            text: @tr("Title and artist are required.");
            color: #D13438;
            font-size: 12px;
            visible: root.invalid-input;
        }

        Text {
            text: root.error-message;
            color: #D13438;
            font-size: 12px;
            visible: root.error-message != "";
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: @tr("Cancel");
                enabled: !root.saving;
                clicked => { root.cancel(); }
            }

            Button {
                text: root.saving ? @tr("Saving...") : @tr("Save");
                enabled: !root.saving;
                clicked => {
                    if root.edited-title == "" || root.edited-artist == "" {
                        root.invalid-input = true;
                    } else {
                        root.save(root.edited-title, root.edited-artist, root.album, root.cover-path, root.lyrics-path);
                    }
                }
            }
        }
    }
}

export component MessagePopup inherits Rectangle {
    in property <string> message;
    callback dismissed();
    width: 100%;
    height: 100%;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 20px;
        spacing: 12px;
        Text {
            text: @tr("Operation failed");
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
        }

        Text {
            text: root.message;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: @tr("Close");
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component SongListView inherits Rectangle {
    in-out property <bool> ascending;
    in-out property <SortKey> sort-key;
    in-out property <SortKey> last-sort-key;
    in-out property <[SongInfo]> song-list;
    in-out property <length> scroll-y;
    in property <SongInfo> current-song;
    callback sort-songs(SortKey, bool);
    callback play-song(SongInfo, TriggerSource);
    callback edit-song(SongInfo);
    callback delete-song(SongInfo);
    background: Theme.surface;
    VerticalLayout {
        width: 100%;
        height: 100%;
        SortBar {
            ascending: root.ascending;
            key: root.sort-key;
            sort-items(key, ascending) => {
                if (root.last-sort-key == key) {
                    root.sort-songs(key, !ascending);
                } else {
                    root.sort-songs(key, true)
                }
            }
        }

        ListView {
            viewport-y <=> root.scroll-y;
            for item in root.song-list: SongItem {
                info: item;
                playing: item.song-path == root.current-song.song-path;
                double_clicked => {
                    root.play-song(item, TriggerSource.ClickItem);
                }
                edit-requested(info) => { root.edit-song(info); }
                delete-requested(info) => { root.delete-song(info); }
            }
        }
    }
}
