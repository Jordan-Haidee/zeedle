import { Theme } from "theme.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";

export component SidebarNavItem inherits Rectangle {
    in property <Icon> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> expanded;
    callback clicked();
    height: 38px;
    border-radius: 8px;
    clip: true;
    background: touch.pressed ? Theme.press : (selected ? Theme.hover : (touch.has-hover ? Theme.hover : transparent));

    Rectangle {
        visible: selected;
        width: 3px;
        height: 16px;
        x: 3px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 10px;
        spacing: expanded ? 10px : 0px;
        animate spacing {
            duration: 180ms;
            easing: ease-out-quad;
        }

        Rectangle {
            width: 20px;
            IconDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: root.icon;
                size: 18px;
                stroke: root.selected ? Theme.accent : Theme.text-secondary;
                stroke-width: 1.8;
            }
        }

        Rectangle {
            clip: true;
            width: expanded ? nav-label.preferred-width : 0px;
            visible: expanded || self.width > 0px;
            animate width {
                duration: 180ms;
                easing: ease-out-quad;
            }
            nav-label := Text {
                width: 100%;
                text: root.label;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.text : Theme.text-secondary;
                vertical-alignment: center;
                overflow: TextOverflow.elide;
                opacity: expanded ? 1 : 0;
                animate opacity { duration: 120ms; }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <bool> expanded: false;
    in property <int> current_page: 0;
    callback change_page(int);
    callback request_focus();

    width: root.expanded ? 200px : 54px;
    background: Theme.panel;
    animate width {
        duration: 200ms;
        easing: ease-out-quad;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;

        Rectangle {
            height: 36px;
            border-radius: 8px;
            background: toggle-touch.has-hover ? Theme.surface : transparent;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 14px;
                padding-right: 10px;

                Rectangle {
                    width: 20px;
                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon: root.expanded ? IconSet.PanelLeftClose : IconSet.PanelLeftOpen;
                        size: 18px;
                        stroke: Theme.text-secondary;
                        stroke-width: 1.8;
                    }
                }
            }

            toggle-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.expanded = !root.expanded;
                    root.request_focus();
                }
            }
        }

        Rectangle {
            height: 4px;
        }

        SidebarNavItem {
            icon: IconSet.ListMusic;
            label: @tr("Gallery");
            selected: root.current_page == 0;
            expanded: root.expanded;
            clicked => {
                root.change_page(0);
            }
        }

        SidebarNavItem {
            icon: IconSet.Search;
            label: @tr("Search");
            selected: root.current_page == 1;
            expanded: root.expanded;
            clicked => {
                root.change_page(1);
            }
        }

        SidebarNavItem {
            icon: IconSet.Captions;
            label: @tr("Lyrics");
            selected: root.current_page == 2;
            expanded: root.expanded;
            clicked => {
                root.change_page(2);
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        SidebarNavItem {
            icon: IconSet.Settings;
            label: @tr("Settings");
            selected: root.current_page == 3;
            expanded: root.expanded;
            clicked => {
                root.change_page(3);
            }
        }

        SidebarNavItem {
            icon: IconSet.CircleHelp;
            label: @tr("About");
            selected: root.current_page == 4;
            expanded: root.expanded;
            clicked => {
                root.change_page(4);
            }
        }
    }
}
