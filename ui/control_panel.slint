import { Theme } from "theme.slint";
import { Slider } from "std-widgets.slint";
import { SongInfo, PlayMode } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";

export component SkipButton inherits Rectangle {
    callback clicked();
    in property <bool> forward: true;
    border-radius: 8px;
    clip: true;
    border-width: 0px;
    property <bool> hovered: touch.has-hover;
    property <bool> pressed: touch.pressed;
    property <color> icon-color: pressed ? Theme.accent : (hovered ? Theme.text : Theme.text-secondary);
    background: pressed ? Theme.press : (hovered ? Theme.hover : transparent);
    animate background {
        duration: 120ms;
        easing: ease-out-quad;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.forward ? IconSet.SkipForward : IconSet.SkipBack;
        size: min(parent.width, parent.height) * 0.72;
        stroke: root.icon-color;
        stroke-width: 2.2;
        absolute-stroke-width: true;
    }
}

export component PlayPauseButton inherits Rectangle {
    in-out property <bool> paused:true;
    callback toggled();
    border-radius: 9px;
    clip: true;
    border-width: 0px;
    property <bool> hovered: touch.has-hover;
    property <bool> pressed: touch.pressed;
    property <color> icon-color: Theme.accent;
    background: pressed ? Theme.press : (hovered ? Theme.hover : transparent);
    animate background {
        duration: 120ms;
        easing: ease-out-quad;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.paused ? IconSet.Play : IconSet.Pause;
        size: min(parent.width, parent.height) * 0.72;
        stroke: root.icon-color;
        stroke-width: 2.2;
        absolute-stroke-width: true;
    }
}

export component PlayModeButton inherits Rectangle {
    in-out property <bool> selected;
    in-out property <bool> recursive: false;
    callback clicked();
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        icon: root.recursive ? IconSet.Repeat2 : IconSet.Repeat;
        size: min(parent.width, parent.height) * 0.9;
        stroke: root.selected ? Theme.accent : Theme.text;
        stroke-width: 1.8;
    }
}


export component OverlapButton inherits Rectangle {
    in-out property <PlayMode> mode;
    callback clicked();
    PlayModeButton {
        width: 100%;
        height: 100%;
        recursive: mode == PlayMode.Recursive;
        selected: mode == PlayMode.Recursive || mode == PlayMode.InOrder;
        clicked => {
            root.clicked();
        }
    }
}

export component RandomButton inherits Rectangle {
    callback clicked();
    in-out property <bool> selected;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
        IconDisplay {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: IconSet.Shuffle;
            size: min(parent.width, parent.height) * 0.9;
            stroke: root.selected ? Theme.accent : Theme.text;
            stroke-width: 1.8;
        }
    }
}

export component MusicVolumeButton inherits Rectangle {
    in property <length> slider-height;
    in property <length> icon-height;
    in-out property <float> volume;
    property <bool> selected: icon.has-hover;
    callback change-volume(float);
    icon := TouchArea {
        if selected:
            Rectangle {
            z: 10;
            Slider {
                x: parent.width * 0.7;
                height: root.slider-height;
                minimum: 0;
                maximum: 1;
                value <=> root.volume;
                orientation: vertical;
                released(value) => {
                    root.change-volume(value);
                }
            }
        }
        Rectangle {
            height: root.icon-height;
            IconDisplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon: IconSet.Volume2;
                size: root.icon-height;
                stroke: root.selected ? Theme.accent : Theme.text;
                stroke-width: 1.8;
            }
        }
    }
}

export component ControlPanel inherits Rectangle {
    background: Theme.surface;

    in-out property <float> progress;
    in property <float> duration;
    in property <bool> paused;
    in property <PlayMode> play_mode;
    in-out property <bool> dragging;
    in property <SongInfo> current_song;
    in property <image> album_image;
    in-out property <float> volume;

    callback change-progress(float);
    callback toggle-play();
    callback play-next();
    callback play-prev();
    callback switch-mode(PlayMode);
    callback change-volume(float);
    callback double-clicked();
    pure callback format-duration(float) -> string;

    VerticalLayout {
        width: 100%;
        height: 100%;
        Slider {
            minimum: 0;
            maximum: root.duration;
            value <=> root.progress;
            released(v) => {
                root.dragging = false;
                change_progress(v);
            }
            changed(_) => {
                root.dragging = true;
            }
        }

        HorizontalLayout {
            height: 80%;
            alignment: center;
            TouchArea {
                width: 35%;
                height: 100%;
                double-clicked => {
                    root.double-clicked()
                };
                HorizontalLayout {
                    alignment: start;
                    spacing: 3px;
                    Rectangle {
                        width: 20%;
                        height: 100%;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 4px;
                            clip: true;
                            drop-shadow-blur: 6px;
                            Image {
                                y: parent.height / 2 - self.height / 2;
                                width: 100%;
                                height: 100%;
                                source: root.album_image;
                                image-fit: contain;
                            }
                        }
                    }

                    Rectangle {
                        width: 80%;
                        height: 100%;
                        cur_song_text := Text {
                            width: 100%;
                            x: parent.width / 2 - self.width / 2;
                            text: root.current_song.song_name + " - " + root.current_song.singer;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: TextOverflow.elide;
                            Tooltip {
                                text: @markdown("\{cur_song_text.text}");
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 6%;
                OverlapButton {
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;
                    width: 20px;
                    height: 20px;
                    mode: root.play_mode;
                    clicked => {
                        if (root.play_mode == PlayMode.InOrder) {
                            root.switch_mode(PlayMode.Recursive);
                        } else {
                            root.switch_mode(PlayMode.InOrder);
                        }
                    }
                }
            }

            Rectangle {
                width: 6%;
                SkipButton {
                    forward: false;
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;
                    width: 36px;
                    height: 36px;
                    clicked => {
                        root.play_prev();
                    }
                }
            }

            Rectangle {
                width: 6%;
                PlayPauseButton {
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;
                    width: 36px;
                    height: 36px;
                    paused: root.paused;
                    toggled => {
                        root.toggle_play();
                    }
                }
            }

            Rectangle {
                width: 6%;
                SkipButton {
                    forward: true;
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;
                    width: 36px;
                    height: 36px;
                    clicked => {
                        root.play_next();
                    }
                }
            }

            Rectangle {
                width: 6%;
                border-color: transparent;
                RandomButton {
                    x: parent.width / 2 - self.width / 2;
                    y: parent.height / 2 - self.height / 2;
                    selected: root.play_mode == PlayMode.Random;
                    width: 20px;
                    height: 20px;
                    clicked => {
                        root.switch_mode(PlayMode.Random);
                    }
                }
            }

            Rectangle {
                width: 25%;
                TouchArea {
                    double-clicked => {
                        root.double-clicked()
                    }
                }

                Text {
                    x: parent.width / 2 - self.width / 2;
                    text: root.format-duration(root.progress) + " / " + root.format-duration(root.duration);
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                width: 10%;
                MusicVolumeButton {
                    icon-height: 20px;
                    slider-height: 55px;
                    volume <=> root.volume;
                    change-volume(v) => {
                        root.change-volume(v)
                    }
                }
            }
        }
    }
}
