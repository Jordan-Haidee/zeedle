import { Theme } from "theme.slint";
import { LineEdit } from "std-widgets.slint";
import { ListView } from "std-widgets.slint";
import { SongItem } from "song_list.slint";
import { SongInfo, TriggerSource } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";

export component SearchPanel inherits Rectangle {
    in-out property <string> search-query;
    in property <[SongInfo]> all-songs;
    in property <[SongInfo]> search-results;
    in property <SongInfo> current-song;
    callback search(string);
    callback play-song(SongInfo, TriggerSource);
    callback edit-song(SongInfo);
    callback delete-song(SongInfo);

    background: Theme.surface;

    // Intercept global shortcuts when the search input has focus,
    // so they don't bubble up to the parent FocusScope and trigger actions.
    // Space/arrows are naturally consumed by LineEdit; only F1-F5 need blocking.
    // Must use key-released (not KeyBinding) to conditionally intercept only
    // when search-input has focus, so shortcuts reach the parent otherwise.
    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-released(event) => {
            if !search-input.has-focus {
                return reject;
            }
            if event.text == Key.F1
                || event.text == Key.F2
                || event.text == Key.F3
                || event.text == Key.F4
                || event.text == Key.F5 {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            // Search bar
        Rectangle {
                height: 40px;
                width: 100%;
                background: Theme.surface;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    search-input := LineEdit {
                        horizontal-stretch: 1;
                        height: 100%;
                        placeholder-text: @tr("Search songs or artists...");
                        text <=> root.search-query;
                        font-size: 13px;

                        edited => {
                            root.search(self.text);
                        }
                    }
                }
            }

            // Results count label
        Rectangle {
                height: 26px;
                width: 100%;
                background: Theme.surface;
                visible: root.search-query != "";

                Text {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    text: root.search-results.length == 0
                        ? @tr("No results found")
                        : @tr("{} result(s) found", root.search-results.length);
                    color: Theme.text-tertiary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Results list
        if root.search-query != "":
            ListView {
                horizontal-stretch: 1;

                for item in root.search-results: SongItem {
                    info: item;
                    playing: item.song-path == root.current-song.song-path;
                    double_clicked => {
                        root.play-song(item, TriggerSource.ClickItem);
                    }
                    edit-requested(info) => { root.edit-song(info); }
                    delete-requested(info) => { root.delete-song(info); }
                }
            }

            // Empty state - show hint when no query
        if root.search-query == "":
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 8px;

                    IconDisplay {
                        x: (parent.width - self.width) / 2;
                        icon: IconSet.Search;
                        size: 44px;
                        stroke: Theme.text-tertiary;
                        stroke-width: 1.8;
                    }

                    Text {
                        text: @tr("Type to search songs");
                        color: Theme.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
